# Copy this file to .env.local for local development, and add the same
# three values in Vercel's Project Settings -> Environment Variables when
# deploying. See DEPLOYMENT.md for exactly where to find each one.

# Settings -> API Keys -> Project URL (Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Settings -> API Keys -> Publishable key.
# Safe to expose in the browser — Row Level Security still gates every
# query. (Older Supabase projects may show this labeled "anon key" under
# a "Legacy API Keys" tab instead — same purpose, same env var here.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Settings -> API Keys -> Secret key.
# SERVER-ONLY. Bypasses Row Level Security entirely — never prefix this
# NEXT_PUBLIC_, never log it, never commit it. (Older projects: this is
# the "service_role key" under "Legacy API Keys".)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
